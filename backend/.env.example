# Copy to .env for local development. Never commit real values.

NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# DynamoDB table holding the desired state (partition key: tenantId)
TABLE_NAME=websg-cms-ip-allowlist
AWS_REGION=ap-southeast-1

# --- Choose ONE of the two blocks below -----------------------------------

# (a) Local DynamoDB via `npm run dev:db`. No AWS account needed.
AWS_ENDPOINT_URL=http://localhost:8000
AWS_ACCESS_KEY_ID=local
AWS_SECRET_ACCESS_KEY=local

# (b) Real AWS, against the deployed table. Delete the three lines above and
# set a profile whose credentials carry iam/backend-api-policy.json:
# AWS_PROFILE=websg-dev
# The SDK reads ~/.aws/credentials - do not put keys in this file.

# --------------------------------------------------------------------------

# Auth. Production must use JWT_JWKS_URL; JWT_SECRET is a local-only fallback.
# JWT_JWKS_URL=https://cognito-idp.ap-southeast-1.amazonaws.com/<pool-id>/.well-known/jwks.json
JWT_SECRET=local-dev-secret-change-me
JWT_ISSUER=https://portal.websg.local
JWT_AUDIENCE=websg-selfservice-api

# Swagger UI at /docs. Defaults to on outside production, off in production.
DOCS_ENABLED=true

# Allowlist policy
MAX_ENTRIES=50
MIN_PREFIX_V4=24
MIN_PREFIX_V6=48
