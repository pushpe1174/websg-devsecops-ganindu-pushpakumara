# Copy to .env. Never commit real values.
# Read by Node's built-in --env-file-if-exists, so there is no dotenv dependency.

PORT=3000
LOG_LEVEL=info

# Real AWS - there is no local DynamoDB. The tables are created by
# `make apply`; the API resolves a tenant's table as <TABLE_PREFIX>-<tenantId>.
#   TABLE_PREFIX = terraform -chdir=terraform output -raw table_prefix
#   AWS_REGION   = terraform -chdir=terraform output -raw region
AWS_REGION=ap-southeast-1
TABLE_PREFIX=websg-cms-allowlist

# Uncomment to use a named profile; otherwise the default profile is used.
# The credentials need iam/backend-api-policy.json.
# The SDK reads ~/.aws/credentials - do not put keys in this file.
# AWS_PROFILE=websg

# Signs and verifies the local access tokens (`npm run token -- user-a`).
JWT_SECRET=change-me
JWT_ISSUER=https://portal.websg.local
JWT_AUDIENCE=websg-selfservice-api

# How long a write waits for the worker to confirm the list is live in WAF
# before answering 202 PENDING instead of 200 APPLIED.
SYNC_WAIT_MS=15000
SYNC_POLL_MS=500

# Allowlist policy
MAX_ENTRIES=50
MIN_PREFIX_V4=24
MIN_PREFIX_V6=48
