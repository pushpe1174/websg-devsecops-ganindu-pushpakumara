{
  "name": "websg-ip-allowlist-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --watch src/server.ts",
    "build": "rm -rf dist && tsc",
    "start": "node dist/server.js",
    "token": "node --env-file-if-exists=.env scripts/dev-token.ts",
    "dev:db": "docker compose up -d",
    "dev:table": "node --env-file-if-exists=.env scripts/create-table.ts",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "node --test \"test/**/*.test.ts\""
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.700.0",
    "@aws-sdk/lib-dynamodb": "^3.700.0",
    "@fastify/swagger": "^9.8.1",
    "@fastify/swagger-ui": "^6.1.1",
    "fastify": "^5.2.0",
    "jose": "^5.9.6"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.7.2"
  }
}
