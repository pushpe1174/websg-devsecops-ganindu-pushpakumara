{
  "Version": "2012-10-17",
  "Statement": [
      {
          "Sid": "TerraformState",
          "Effect": "Allow",
          "Action": [
              "s3:CreateBucket",
              "s3:ListBucket",
              "s3:GetBucketLocation",
              "s3:GetBucketVersioning",
              "s3:PutBucketVersioning",
              "s3:GetEncryptionConfiguration",
              "s3:PutEncryptionConfiguration",
              "s3:GetBucketPublicAccessBlock",
              "s3:PutBucketPublicAccessBlock"
          ],
          "Resource": "arn:aws:s3:::websg-custom-tfstate-273804046957"
      },
      {
          "Sid": "TerraformStateObjectsAndLock",
          "Effect": "Allow",
          "Action": [
              "s3:GetObject",
              "s3:PutObject",
              "s3:DeleteObject"
          ],
          "Resource": "arn:aws:s3:::websg-custom-tfstate-273804046957/websg-custom/*"
      },
      {
          "Sid": "AllowlistTables",
          "Effect": "Allow",
          "Action": [
              "dynamodb:CreateTable",
              "dynamodb:DeleteTable",
              "dynamodb:DescribeTable",
              "dynamodb:UpdateTable",
              "dynamodb:DescribeContinuousBackups",
              "dynamodb:UpdateContinuousBackups",
              "dynamodb:DescribeTimeToLive",
              "dynamodb:ListTagsOfResource",
              "dynamodb:TagResource",
              "dynamodb:UntagResource"
          ],
          "Resource": [
              "arn:aws:dynamodb:ap-southeast-1:273804046957:table/websg-cms-allowlist-*"
          ]
      },
      {
          "Sid": "SyncQueues",
          "Effect": "Allow",
          "Action": [
              "sqs:CreateQueue",
              "sqs:DeleteQueue",
              "sqs:GetQueueAttributes",
              "sqs:SetQueueAttributes",
              "sqs:GetQueueUrl",
              "sqs:ListQueueTags",
              "sqs:TagQueue",
              "sqs:UntagQueue"
          ],
          "Resource": [
              "arn:aws:sqs:ap-southeast-1:273804046957:websg-cms-allowlist-waf-sync.fifo",
              "arn:aws:sqs:ap-southeast-1:273804046957:websg-cms-allowlist-waf-sync-dlq.fifo"
          ]
      },
      {
          "Sid": "SyncFunction",
          "Effect": "Allow",
          "Action": [
              "lambda:CreateFunction",
              "lambda:DeleteFunction",
              "lambda:GetFunction",
              "lambda:GetFunctionConfiguration",
              "lambda:GetFunctionCodeSigningConfig",
              "lambda:GetPolicy",
              "lambda:UpdateFunctionCode",
              "lambda:UpdateFunctionConfiguration",
              "lambda:ListVersionsByFunction",
              "lambda:PutFunctionConcurrency",
              "lambda:DeleteFunctionConcurrency",
              "lambda:TagResource",
              "lambda:UntagResource",
              "lambda:ListTags"
          ],
          "Resource": "arn:aws:lambda:ap-southeast-1:273804046957:function:websg-cms-allowlist-waf-sync"
      },
      {
          "Sid": "SyncFunctionEventSourceMapping",
          "Effect": "Allow",
          "Action": [
              "lambda:CreateEventSourceMapping",
              "lambda:DeleteEventSourceMapping",
              "lambda:GetEventSourceMapping",
              "lambda:ListEventSourceMappings",
              "lambda:UpdateEventSourceMapping"
          ],
          "Resource": "*"
      },
      {
          "Sid": "SyncFunctionEventSourceMappingTagging",
          "Effect": "Allow",
          "Action": [
              "lambda:TagResource",
              "lambda:UntagResource",
              "lambda:ListTags"
          ],
          "Resource": [
              "arn:aws:lambda:ap-southeast-1:273804046957:function:websg-cms-allowlist-waf-sync",
              "arn:aws:lambda:ap-southeast-1:273804046957:event-source-mapping:*"
          ]
      },
      {
          "Sid": "StreamToQueuePipe",
          "Effect": "Allow",
          "Action": [
              "pipes:CreatePipe",
              "pipes:DeletePipe",
              "pipes:DescribePipe",
              "pipes:UpdatePipe",
              "pipes:ListTagsForResource",
              "pipes:TagResource",
              "pipes:UntagResource"
          ],
          "Resource": "arn:aws:pipes:ap-southeast-1:273804046957:pipe/websg-cms-allowlist-waf-sync-*"
      },
      {
          "Sid": "ExecutionRoles",
          "Effect": "Allow",
          "Action": [
              "iam:CreateRole",
              "iam:DeleteRole",
              "iam:GetRole",
              "iam:UpdateAssumeRolePolicy",
              "iam:PutRolePolicy",
              "iam:GetRolePolicy",
              "iam:DeleteRolePolicy",
              "iam:ListRolePolicies",
              "iam:ListAttachedRolePolicies",
              "iam:ListInstanceProfilesForRole",
              "iam:TagRole",
              "iam:UntagRole"
          ],
          "Resource": "arn:aws:iam::273804046957:role/websg-cms-allowlist-*"
      },
      {
          "Sid": "PassExecutionRolesToTheirOwnServiceOnly",
          "Effect": "Allow",
          "Action": "iam:PassRole",
          "Resource": "arn:aws:iam::273804046957:role/websg-cms-allowlist-*",
          "Condition": {
              "StringEquals": {
                  "iam:PassedToService": [
                      "lambda.amazonaws.com",
                      "pipes.amazonaws.com"
                  ]
              }
          }
      },
      {
          "Sid": "FunctionLogGroup",
          "Effect": "Allow",
          "Action": [
              "logs:CreateLogGroup",
              "logs:DeleteLogGroup",
              "logs:PutRetentionPolicy",
              "logs:DeleteRetentionPolicy",
              "logs:ListTagsForResource",
              "logs:TagResource",
              "logs:UntagResource"
          ],
          "Resource": "arn:aws:logs:ap-southeast-1:273804046957:log-group:/aws/lambda/websg-cms-allowlist-waf-sync*"
      },
      {
          "Sid": "GlobalLogGroupDiscovery",
          "Effect": "Allow",
          "Action": [
              "logs:DescribeLogGroups"
          ],
          "Resource": "*"
      },
      {
          "Sid": "Alerting",
          "Effect": "Allow",
          "Action": [
              "sns:CreateTopic",
              "sns:DeleteTopic",
              "sns:GetTopicAttributes",
              "sns:SetTopicAttributes",
              "sns:Subscribe",
              "sns:Unsubscribe",
              "sns:GetSubscriptionAttributes",
              "sns:ListSubscriptionsByTopic",
              "sns:ListTagsForResource",
              "sns:TagResource",
              "sns:UntagResource"
          ],
          "Resource": "arn:aws:sns:ap-southeast-1:273804046957:websg-cms-allowlist-alerts"
      },
      {
          "Sid": "Alarms",
          "Effect": "Allow",
          "Action": [
              "cloudwatch:PutMetricAlarm",
              "cloudwatch:DeleteAlarms",
              "cloudwatch:DescribeAlarms",
              "cloudwatch:ListTagsForResource",
              "cloudwatch:TagResource",
              "cloudwatch:UntagResource"
          ],
          "Resource": "arn:aws:cloudwatch:ap-southeast-1:273804046957:alarm:websg-cms-allowlist-*"
      },
      {
          "Sid": "ManageTenantIpSets",
          "Effect": "Allow",
          "Action": [
              "wafv2:GetIPSet",
              "wafv2:ListIPSets",
              "wafv2:CreateIPSet",
              "wafv2:DeleteIPSet",
              "wafv2:ListTagsForResource",
              "wafv2:TagResource",
              "wafv2:UntagResource"
          ],
          "Resource": "*"
      },
      {
          "Sid": "DriftCheckSchedule",
          "Effect": "Allow",
          "Action": [
              "events:PutRule",
              "events:DeleteRule",
              "events:DescribeRule",
              "events:PutTargets",
              "events:RemoveTargets",
              "events:ListTargetsByRule",
              "events:ListTagsForResource",
              "events:TagResource",
              "events:UntagResource"
          ],
          "Resource": "arn:aws:events:ap-southeast-1:273804046957:rule/websg-cms-allowlist-waf-sync-drift-check"
      }
  ]
}