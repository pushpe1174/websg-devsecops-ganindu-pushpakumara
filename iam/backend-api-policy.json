{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadWriteTenantAllowlists",
      "Effect": "Allow",
      "Action": [
        "dynamodb:GetItem",
        "dynamodb:PutItem",
        "dynamodb:UpdateItem"
      ],
      "Resource": "arn:aws:dynamodb:ap-southeast-1:111122223333:table/websg-cms-ip-allowlist"
    },
    {
      "Sid": "ManageTenantIpSetAssignments",
      "Effect": "Allow",
      "Action": [
        "dynamodb:GetItem",
        "dynamodb:PutItem",
        "dynamodb:DeleteItem",
        "dynamodb:Scan"
      ],
      "Resource": "arn:aws:dynamodb:ap-southeast-1:111122223333:table/websg-cms-ip-allowlist-tenants"
    }
  ]
}
